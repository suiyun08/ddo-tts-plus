<?xml version="1.0" encoding="utf-8"?>
<!--阅读菜单「朗读」面板：播放控制、语速、定时、语音/引擎/设置、后台朗读-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!--播放控制：上一段 / 播放·暂停 / 下一段 / 停止-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_play_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/prev_sentence"
                android:padding="12dp"
                android:src="@drawable/ic_skip_previous" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="24dp"
                android:contentDescription="@string/audio_play"
                android:padding="14dp"
                android:src="@drawable/ic_play_24dp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_play_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_sentence"
                android:padding="12dp"
                android:src="@drawable/ic_skip_next" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_stop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stop"
                android:padding="12dp"
                android:src="@drawable/ic_stop_black_24dp" />

        </LinearLayout>

        <!--语速-->
        <LinearLayout
            android:id="@+id/ll_tts_SpeechRate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tts_speed"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/read_aloud_speed_short"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_tts_speech_reduce"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/reduce"
                android:padding="6dp"
                android:src="@drawable/ic_reduce" />

            <io.legado.app.lib.theme.view.ThemeSeekBar
                android:id="@+id/seek_tts_speechRate"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="45" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_tts_speech_add"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/plus"
                android:padding="6dp"
                android:src="@drawable/ic_add" />

            <TextView
                android:id="@+id/tv_tts_speed_value"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:singleLine="true"
                android:textSize="13sp"
                tools:text="1.0" />

            <TextView
                android:id="@+id/tv_tts_follow_sys"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="@string/flow_sys"
                android:textSize="12sp" />

        </LinearLayout>

        <!--定时：拖动设置本次定时，点数值选常用时长，点时钟图标存为默认-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_timer_title"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/read_aloud_timer"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_timer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/read_aloud_timer"
                android:padding="6dp"
                android:src="@drawable/ic_time_add_24dp" />

            <io.legado.app.lib.theme.view.ThemeSeekBar
                android:id="@+id/seek_timer"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="180" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="12sp"
                tools:text="30 分钟" />

        </LinearLayout>

        <!--语音 / 朗读引擎 / 朗读设置-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-4dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_voice"
                style="@style/ReadMenuTile"
                android:layout_height="56dp"
                android:singleLine="false" />

            <TextView
                android:id="@+id/tv_engine"
                style="@style/ReadMenuTile"
                android:layout_height="56dp"
                android:singleLine="false" />

            <TextView
                android:id="@+id/tv_aloud_setting"
                style="@style/ReadMenuTile"
                android:layout_height="56dp"
                android:singleLine="false" />

        </LinearLayout>

        <!--后台朗读-->
        <TextView
            android:id="@+id/tv_to_backstage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/read_aloud_backstage"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
